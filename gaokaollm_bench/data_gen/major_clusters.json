{
  "version": 3,
  "description": "Auditable major cluster forest. The skeleton is human-reviewed; observed_names should be populated by scanning admission_scores.major_name_raw.",
  "tree_policy": {
    "stages": [
      {
        "stage": 1,
        "strategy": "same_leaf_variants",
        "label": "同叶子簇变体",
        "psychological_distance": "very_near",
        "description": "Keep the source leaf cluster but allow observed name variants inside that cluster."
      },
      {
        "stage": 2,
        "strategy": "sibling_leaf_clusters",
        "label": "同父节点近邻簇",
        "psychological_distance": "near",
        "description": "Relax to sibling leaf clusters under the same parent as the source leaf."
      },
      {
        "stage": 3,
        "strategy": "cousin_leaf_clusters",
        "label": "上层大类近邻簇",
        "psychological_distance": "medium",
        "description": "Relax to other leaf clusters under the grandparent/root category, excluding the source branch."
      },
      {
        "stage": 4,
        "strategy": "ancestor_category",
        "label": "大类兜底",
        "psychological_distance": "far",
        "description": "Use the broad ancestor/root category as a final fallback."
      }
    ]
  },
