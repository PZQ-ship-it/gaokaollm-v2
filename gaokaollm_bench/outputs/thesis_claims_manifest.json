      "evidence": "gaokaollm_bench/outputs/thesis_data_agent_benchmark_extension_evidence.md",
      "note": "较粗粒度学校/学科实力证据接入闭环。"
    },
    "tuition_value_v1": {
      "role": "extension",
      "relaxation": "tuition_value_relax",
