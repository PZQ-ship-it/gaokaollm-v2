{
  "schema_version": "1.0",
  "updated_date": "2026-05-12",
  "purpose": "Single source of high-frequency thesis claims for the data + Agent + Benchmark storyline.",
  "contribution_structure": {
    "primary_frame": "数据 + Agent + Benchmark",
    "data_contribution": [
      "PostgreSQL 招生快照",
      "分数/位次/批次线/招生计划/学费事实",
      "专业层级本体",
      "学校-专业质量画像",
      "专业就业结果画像",
      "地理邻近层级画像",
      "城市层级画像"
    ],
    "agent_contribution": {
      "mas_positioning": "基于角色分工的轻量 MAS/多角色 Agent 工作流；业务 Agent 由前置语义归一层、约束解析器、LLM 引导的机会规划器、确定性证据探针和证据谈判器协作完成，不夸大为完全自治多智能体系统。",
      "workflow": "semantic_normalizer -> gatekeeper -> llm-guided radar planner -> deterministic probes -> negotiator",
      "thesis_expression": "前置语义归一层 -> 约束解析器 -> LLM 引导的机会规划器 -> 确定性证据探针 -> 证据谈判器",
      "implementation_roles": {
        "semantic_normalizer": "前置语义归一层：继承 v1 查询重写能力，只对用户显式话语做语义归一、偏好轴拆解、歧义提示和查询压缩。",
        "gatekeeper": "约束解析器：抽取用户显式约束并形成 hard-constraint baseline。",
        "radar_planner": "LLM 引导的机会规划器：输出 probe_plan、opportunity_rankings、clarification_hint，不生成事实候选。",
        "deterministic_probes": "确定性证据探针：通过 PostgreSQL 与标准化证据层产生可审计候选，是事实候选唯一来源。",
        "negotiator": "证据谈判器：组织真实证据并生成可审计的 Pareto 谈判回复。"
      },
      "llm_boundary": "LLM 只参与语义归一、机会排序、证据编排和澄清策略；不直接编造候选学校、专业、分数或位次。"
    },
    "benchmark_contribution": [
      "冰山画像",
      "多轮沙盒",
      "事实/过程联合评价",
      "app_pareto vs hard_constraint"
    ]
  },
  "global_boundaries": {
    "hidden_persona_boundary": "Agent 不读取 implicit_flexibilities、volunteer_set 或 axis_flexibilities；这些字段只作为 simulator/evaluator ground truth。",
